# Server-side only. Never prefix these with VITE_.
RESEND_API_KEY=
# Where contact-form messages and guestbook notes are delivered
RISHTA_TO_EMAIL=advaitasharma2003@gmail.com
# A sender on a domain you verified in Resend (or onboarding@resend.dev while testing)
RISHTA_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Any long random string. Protects the private guestbook review link.
MODERATION_SECRET=

# Notes wait for your approval by default. Set to true to publish instantly (suspicious ones are still held).
GUESTBOOK_AUTO_PUBLISH=false

# Optional: "Sign in with Google" on the guestbook (shows each visitor's verified name and photo).
# Create a free OAuth Client ID at https://console.cloud.google.com/apis/credentials and put the SAME value in both:
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
